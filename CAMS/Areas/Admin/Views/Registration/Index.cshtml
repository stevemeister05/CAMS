@using CAMS.Domain.Enums

@{
	ViewBag.Title =
		"Registration Requests";

	ViewBag.PageTitle =
		"Registration Requests";

	ViewBag.pTitle =
		"REGISTRATIONS";

	Layout =
		"/Views/Shared/_Layout.cshtml";
}


<div id="registration-page"
	 data-status-pending="@((int)RegistrationStatus.Pending)"
	 data-status-approved="@((int)RegistrationStatus.Approved)"
	 data-status-rejected="@((int)RegistrationStatus.Rejected)">


	<!-- =========================================================
		 FILTERS
	========================================================= -->

	<div class="card">

		<div class="card-body">

			<div class="row g-3 align-items-end">

				<div class="col-lg-6">

					<label for="registration-search"
						   class="form-label">

						Search

					</label>

					<div class="position-relative">

						<input type="search"
							   id="registration-search"
							   class="form-control"
							   placeholder="Search name or mobile number..."
							   autocomplete="off">

						<i class="ri-search-line position-absolute
								  top-50 end-0 translate-middle-y
								  me-3 text-muted"></i>

					</div>

				</div>


				<div class="col-lg-3">

					<label for="registration-status"
						   class="form-label">

						Status

					</label>

					<select id="registration-status"
							class="form-select">

						<option value="">
							All
						</option>

						<option value="@((int)RegistrationStatus.Pending)"
								selected>
							Pending
						</option>

						<option value="@((int)RegistrationStatus.Approved)">
							Approved
						</option>

						<option value="@((int)RegistrationStatus.Rejected)">
							Rejected
						</option>

					</select>

				</div>


				<div class="col-lg-3">

					<label for="registration-page-size"
						   class="form-label">

						Rows

					</label>

					<select id="registration-page-size"
							class="form-select">

						<option value="10">
							10
						</option>

						<option value="20"
								selected>
							20
						</option>

						<option value="50">
							50
						</option>

					</select>

				</div>

			</div>

		</div>

	</div>


	<!-- =========================================================
		 REGISTRATION TABLE
	========================================================= -->

	<div class="card">

		<div class="card-header">

			<div class="d-flex align-items-center">

				<div class="flex-grow-1">

					<h5 class="card-title mb-1">
						Registration Requests
					</h5>

					<p class="text-muted mb-0"
					   id="registration-result-summary">

						Loading registrations...

					</p>

				</div>

				<button type="button"
						id="registration-refresh"
						class="btn btn-soft-primary btn-sm">

					<i class="ri-refresh-line me-1"></i>

					Refresh

				</button>

			</div>

		</div>


		<div class="card-body p-0">

			<div class="table-responsive">

				<table class="table table-hover
							  table-nowrap align-middle mb-0">

					<thead class="table-light">

						<tr>

							<th>
								Name
							</th>

							<th>
								Mobile Number
							</th>

							<th>
								Registered
							</th>

							<th>
								Status
							</th>

							<th class="text-end">
								Action
							</th>

						</tr>

					</thead>


					<tbody id="registration-table-body">

						<tr>

							<td colspan="5"
								class="text-center py-5 text-muted">

								<div class="spinner-border
											spinner-border-sm me-2"
									 role="status">
								</div>

								Loading registration requests...

							</td>

						</tr>

					</tbody>

				</table>

			</div>

		</div>


		<div class="card-footer">

			<div class="d-flex flex-column
						flex-md-row align-items-center
						justify-content-between gap-3">

				<div id="registration-pagination-info"
					 class="text-muted">
				</div>

				<nav aria-label="Registration pagination">

					<ul id="registration-pagination"
						class="pagination pagination-sm mb-0">
					</ul>

				</nav>

			</div>

		</div>

	</div>

</div>


<!-- =============================================================
	 REVIEW MODAL
============================================================= -->

<div class="modal fade"
	 id="registration-review-modal"
	 tabindex="-1"
	 aria-labelledby="registration-review-title"
	 aria-hidden="true">

	<div class="modal-dialog modal-dialog-centered modal-lg">

		<div class="modal-content">

			<div class="modal-header">

				<div>

					<h5 class="modal-title"
						id="registration-review-title">

						Registration Request

					</h5>

					<p id="registration-review-subtitle"
					   class="text-muted mb-0">
					</p>

				</div>

				<button type="button"
						class="btn-close"
						data-bs-dismiss="modal"
						aria-label="Close">
				</button>

			</div>


			<div class="modal-body">

				<div id="registration-review-loading"
					 class="text-center py-5">

					<div class="spinner-border text-primary"
						 role="status">
					</div>

					<div class="text-muted mt-3">
						Loading registration...
					</div>

				</div>


				<div id="registration-review-content"
					 class="d-none">

					<div class="row g-4">

						<div class="col-md-6">

							<label class="text-muted fs-sm">
								First Name
							</label>

							<div id="review-first-name"
								 class="fw-medium">
							</div>

						</div>


						<div class="col-md-6">

							<label class="text-muted fs-sm">
								Middle Name
							</label>

							<div id="review-middle-name"
								 class="fw-medium">
							</div>

						</div>


						<div class="col-md-6">

							<label class="text-muted fs-sm">
								Last Name
							</label>

							<div id="review-last-name"
								 class="fw-medium">
							</div>

						</div>


						<div class="col-md-6">

							<label class="text-muted fs-sm">
								Mobile Number
							</label>

							<div id="review-mobile-number"
								 class="fw-medium">
							</div>

						</div>


						<div class="col-md-6">

							<label class="text-muted fs-sm">
								Registered
							</label>

							<div id="review-registered-at"
								 class="fw-medium">
							</div>

						</div>


						<div class="col-md-6">

							<label class="text-muted fs-sm">
								Status
							</label>

							<div id="review-status">
							</div>

						</div>

					</div>


					<div id="registration-reject-section"
						 class="mt-4 d-none">

						<hr>

						<label for="registration-reject-reason"
							   class="form-label">

							Reason for rejection

						</label>

						<textarea id="registration-reject-reason"
								  class="form-control"
								  rows="3"
								  placeholder="Enter the reason for rejecting this registration..."></textarea>

					</div>

				</div>

			</div>


			<div class="modal-footer"
				 id="registration-review-footer">

				<button type="button"
						class="btn btn-light"
						data-bs-dismiss="modal">

					Close

				</button>

				<button type="button"
						id="registration-reject-button"
						class="btn btn-danger d-none">

					<i class="ri-close-circle-line me-1"></i>

					Reject

				</button>

				<button type="button"
						id="registration-approve-button"
						class="btn btn-success d-none">

					<i class="ri-check-line me-1"></i>

					Approve

				</button>

			</div>

		</div>

	</div>

</div>


@section Scripts {

	<script src="~/js/pages/admin/registrations.js"
			asp-append-version="true"></script>

}