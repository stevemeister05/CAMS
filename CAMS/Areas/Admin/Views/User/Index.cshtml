@using CAMS.Domain.Constants

@{
	ViewData["Title"] = "Users";
	Layout = "/Views/Shared/_Layout.cshtml";
}


<div id="users-page"
	 data-role-administrator="@ApplicationRoles.Administrator"
	 data-role-attendance-staff="@ApplicationRoles.AttendanceStaff"
	 data-role-member="@ApplicationRoles.Member">


	<div class="row">

		<div class="col-12">

			<div class="card">

				<div class="card-header">

					<div class="d-flex flex-wrap
						align-items-center
						justify-content-between
						gap-2">

						<div>

							<h5 class="card-title mb-1">
								Users
							</h5>

							<p class="text-muted mb-0">
								Manage administrator, attendance staff,
								and member user accounts.
							</p>

						</div>


						<div class="d-flex
							flex-wrap
							align-items-center
							gap-2">

							<button type="button"
									id="refresh-users-button"
									class="btn btn-soft-secondary">

								<i class="ri-refresh-line
									align-middle me-1">
								</i>

								Refresh

							</button>


							<button type="button"
									id="create-user-button"
									class="btn btn-primary">

								<i class="ri-user-add-line
									align-middle me-1">
								</i>

								Add Staff User

							</button>

						</div>

					</div>

				</div>


				<div class="card-body border-bottom">

					<div class="row g-3">

						<div class="col-lg-5">

							<div class="search-box">

								<input type="text"
									   id="user-search"
									   class="form-control"
									   placeholder="Search username or member..." />

								<i class="ri-search-line search-icon">
								</i>

							</div>

						</div>


						<div class="col-lg-3">

							<select id="user-role-filter"
									class="form-select">

								<option value="">
									All User Types
								</option>

								<option value="@ApplicationRoles.Administrator">
									Administrator
								</option>

								<option value="@ApplicationRoles.AttendanceStaff">
									Attendance Staff
								</option>

								<option value="@ApplicationRoles.Member">
									Member
								</option>

							</select>

						</div>


						<div class="col-lg-3">

							<select id="user-status-filter"
									class="form-select">

								<option value="">
									All Statuses
								</option>

								<option value="true">
									Active
								</option>

								<option value="false">
									Disabled
								</option>

							</select>

						</div>

					</div>

				</div>


				<div class="card-body p-0">

					<div class="table-responsive">

						<table class="table table-hover
							align-middle mb-0">

							<thead class="table-light">

								<tr>

									<th class="ps-3">
										User
									</th>

									<th>
										User Type
									</th>

									<th>
										Member
									</th>

									<th>
										Password
									</th>

									<th>
										Status
									</th>

									<th class="text-end pe-3">
										Actions
									</th>

								</tr>

							</thead>


							<tbody id="user-table-body">
							</tbody>

						</table>

					</div>

				</div>

			</div>

		</div>

	</div>


	<!-- =====================================================
		 USER MODAL
	===================================================== -->

	<div class="modal fade"
		 id="user-modal"
		 tabindex="-1"
		 aria-hidden="true">

		<div class="modal-dialog modal-dialog-centered">

			<div class="modal-content">

				<form id="user-form"
					  novalidate>

					<div class="modal-header">

						<h5 class="modal-title"
							id="user-modal-title">
							Add Staff User
						</h5>

						<button type="button"
								class="btn-close"
								data-bs-dismiss="modal"
								aria-label="Close">
						</button>

					</div>


					<div class="modal-body">

						<div id="user-form-alert">
						</div>


						<input type="hidden"
							   id="user-id" />


						<div class="mb-3">

							<label for="user-role"
								   class="form-label">
								User Type
							</label>

							<select id="user-role"
									class="form-select"
									required>

								<option value="">
									Select User Type
								</option>

								<option value="@ApplicationRoles.Administrator">
									Administrator
								</option>

								<option value="@ApplicationRoles.AttendanceStaff">
									Attendance Staff
								</option>

							</select>

						</div>


						<div class="mb-3">

							<label for="user-name"
								   class="form-label">
								Username
							</label>

							<input type="text"
								   id="user-name"
								   class="form-control"
								   maxlength="256"
								   autocomplete="off"
								   required />

						</div>


						<div id="user-password-group">

							<div class="mb-3">

								<label for="user-password"
									   class="form-label">
									Initial Password
								</label>

								<input type="password"
									   id="user-password"
									   class="form-control"
									   autocomplete="new-password"
									   required />

								<div class="form-text">
									The user will be required to change
									this password after signing in.
								</div>

							</div>

						</div>

					</div>


					<div class="modal-footer">

						<button type="button"
								class="btn btn-light"
								data-bs-dismiss="modal">
							Cancel
						</button>

						<button type="submit"
								id="save-user-button"
								class="btn btn-primary">
							Save User
						</button>

					</div>

				</form>

			</div>

		</div>

	</div>

</div>


@section scripts {

	<script src="~/js/pages/admin/users.js"
			asp-append-version="true">
	</script>

}