@{
	ViewData["Title"] =
		"Member Attendance Count";
	ViewBag.PageTitle = "Dashboard";
	ViewBag.pTitle = "Member Attendance Count Report";

	Layout = "/Views/Shared/_Layout.cshtml";
}


<div id="member-attendance-count-report-page">

	<div class="row">

		<div class="col-12">


			<div class="mb-4">

				<h4 class="mb-1">
					Member Attendance Count
				</h4>

				<p class="text-muted mb-0">
					View members according to their
					attendance count within a selected period.
				</p>

			</div>


			<div id="member-attendance-count-report-alert">
			</div>


			<div class="card">

				<div class="card-body">


					<form id="member-attendance-count-report-form">

						<div class="row
							g-3
							align-items-end">


							<div class="col-xl-2 col-md-3">

								<label for="date-from"
									   class="form-label">

									Date From

								</label>

								<input type="date"
									   id="date-from"
									   class="form-control"
									   required />

							</div>


							<div class="col-xl-2 col-md-3">

								<label for="date-to"
									   class="form-label">

									Date To

								</label>

								<input type="date"
									   id="date-to"
									   class="form-control"
									   required />

							</div>


							<div class="col-xl-2 col-md-3">

								<label for="minimum-count"
									   class="form-label">

									Minimum Count

								</label>

								<input type="number"
									   id="minimum-count"
									   class="form-control"
									   min="0" />

							</div>


							<div class="col-xl-2 col-md-3">

								<label for="maximum-count"
									   class="form-label">

									Maximum Count

								</label>

								<input type="number"
									   id="maximum-count"
									   class="form-control"
									   min="0" />

							</div>


							<div class="col-xl-4">

								<div class="d-flex
									flex-wrap
									gap-2">

									<button type="submit"
											id="generate-report-button"
											class="btn btn-primary">

										<i class="ri-search-line
											align-middle
											me-1">
										</i>

										Generate Report

									</button>


									<button type="button"
											id="export-excel-button"
											class="btn btn-success"
											disabled>

										<i class="ri-file-excel-2-line
											align-middle
											me-1">
										</i>

										Excel

									</button>


									<button type="button"
											id="export-pdf-button"
											class="btn btn-danger"
											disabled>

										<i class="ri-file-pdf-2-line
											align-middle
											me-1">
										</i>

										PDF

									</button>

								</div>

							</div>


						</div>

					</form>


				</div>

			</div>


			<div class="card">

				<div class="card-header">

					<div class="d-flex
						align-items-center
						justify-content-between">

						<h5 class="card-title mb-0">
							Members
						</h5>


						<span id="report-record-count"
							  class="badge
							bg-primary-subtle
							text-primary">

							0

						</span>

					</div>

				</div>


				<div class="card-body p-0">

					<div class="table-responsive">

						<table class="table
							table-hover
							align-middle
							mb-0">

							<thead class="table-light">

								<tr>

									<th class="ps-3">
										Member
									</th>

									<th class="text-center pe-3">
										Attendance Count
									</th>

								</tr>

							</thead>


							<tbody id="report-table-body">

								<tr>

									<td colspan="2"
										class="text-center
										text-muted
										py-5">

										Select your filters and
										generate the report.

									</td>

								</tr>

							</tbody>

						</table>

					</div>

				</div>

			</div>


		</div>

	</div>

</div>


@section scripts {

	<script src="~/js/pages/reports/member-attendance-count.js"
			asp-append-version="true">
	</script>

}