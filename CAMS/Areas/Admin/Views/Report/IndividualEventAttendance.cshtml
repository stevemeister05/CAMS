@{
	ViewData["Title"] =
		"Individual Event Attendance";

	ViewBag.PageTitle = "Dashboard";
	ViewBag.pTitle = "Individual Event Attendance";

	Layout = "/Views/Shared/_Layout.cshtml";
}


<link rel="stylesheet"
	  href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />


<style>

	.select2-container {
		width: 100% !important;
	}


		.select2-container .select2-selection--single {
			height: 38px;
			border: 1px solid var(--tb-border-color);
			border-radius: 0.375rem;
		}


			.select2-container
			.select2-selection--single
			.select2-selection__rendered {
				line-height: 36px;
				padding-left: 12px;
			}


			.select2-container
			.select2-selection--single
			.select2-selection__arrow {
				height: 36px;
			}


	.select2-container--default
	.select2-selection--single
	.select2-selection__placeholder {
		color: var(--tb-secondary-color);
	}


	.select2-container--default.select2-container--focus
	.select2-selection--single {
		border-color: var(--tb-primary);
	}

</style>


<div id="individual-event-attendance-report-page">

	<div class="row">

		<div class="col-12">


			<!-- =====================================================
				 PAGE HEADER
			===================================================== -->

			<div class="mb-4">

				<h4 class="mb-1">
					Individual Event Attendance
				</h4>

				<p class="text-muted mb-0">
					View all members who attended
					a specific event.
				</p>

			</div>


			<div id="individual-event-attendance-report-alert">
			</div>


			<!-- =====================================================
				 FILTERS
			===================================================== -->

			<div class="card">

				<div class="card-body">


					<form id="individual-event-attendance-report-form">

						<div class="row
							g-3
							align-items-end">


							<div class="col-xl-5
								col-md-6">

								<label for="event-id"
									   class="form-label">

									Event

								</label>


								<select id="event-id"
										class="form-select"
										style="width: 100%;"
										disabled
										required>

									<option value="">
										Loading events...
									</option>

								</select>

							</div>


							<div class="col-xl-7
								col-md-6">

								<div class="d-flex
									flex-wrap
									gap-2">

									<button type="submit"
											id="generate-report-button"
											class="btn btn-primary">

										<i class="ri-search-line
											align-middle
											me-1">
										</i>

										Generate Report

									</button>


									<button type="button"
											id="export-excel-button"
											class="btn btn-success"
											disabled>

										<i class="ri-file-excel-2-line
											align-middle
											me-1">
										</i>

										Excel

									</button>


									<button type="button"
											id="export-pdf-button"
											class="btn btn-danger"
											disabled>

										<i class="ri-file-pdf-2-line
											align-middle
											me-1">
										</i>

										PDF

									</button>

								</div>

							</div>


						</div>

					</form>


				</div>

			</div>


			<!-- =====================================================
				 REPORT
			===================================================== -->

			<div class="card">

				<div class="card-header">

					<div class="d-flex
						align-items-center
						justify-content-between
						flex-wrap
						gap-2">

						<div>

							<h5 id="selected-event-name"
								class="card-title mb-1">

								Attendance Records

							</h5>


							<div id="selected-event-date"
								 class="text-muted fs-12">
							</div>

						</div>


						<span id="report-record-count"
							  class="badge
							bg-primary-subtle
							text-primary">

							0

						</span>

					</div>

				</div>


				<div class="card-body p-0">

					<div class="table-responsive">

						<table class="table
							table-hover
							align-middle
							mb-0">

							<thead class="table-light">

								<tr>

									<th class="ps-3">
										Member
									</th>

									<th>
										Time In
									</th>

									<th class="pe-3">
										Time Out
									</th>

								</tr>

							</thead>


							<tbody id="report-table-body">

								<tr>

									<td colspan="3"
										class="text-center
										text-muted
										py-5">

										Select an event and
										generate the report.

									</td>

								</tr>

							</tbody>

						</table>

					</div>

				</div>

			</div>


		</div>

	</div>

</div>


@section scripts {

	<script src="https://code.jquery.com/jquery-3.7.1.min.js">
	</script>

	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js">
	</script>

	<script src="~/js/pages/reports/individual-event-attendance.js"
			asp-append-version="true">
	</script>

}