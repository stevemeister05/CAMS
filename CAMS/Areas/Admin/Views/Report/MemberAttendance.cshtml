@{
	ViewData["Title"] =
		"Member Attendance Report";
	ViewBag.PageTitle = "Dashboard";
	ViewBag.pTitle = "Member Attendance Report";

	Layout = "/Views/Shared/_Layout.cshtml";

}


<div id="member-attendance-report-page">

	<div class="row">

		<div class="col-12">


			<div class="d-flex
				align-items-center
				justify-content-between
				flex-wrap
				gap-2
				mb-4">

				<div>

					<h4 class="mb-1">
						Member Attendance Report
					</h4>

					<p class="text-muted mb-0">
						View member attendance records
						within a selected date range.
					</p>

				</div>

			</div>


			<div id="member-attendance-report-alert">
			</div>


			<div class="card">

				<div class="card-body">


					<form id="member-attendance-report-form">

						<div class="row
							g-3
							align-items-end">


							<div class="col-xl-3
								col-md-4">

								<label for="date-from"
									   class="form-label">

									Date From

								</label>

								<input type="date"
									   id="date-from"
									   class="form-control"
									   required />

							</div>


							<div class="col-xl-3
								col-md-4">

								<label for="date-to"
									   class="form-label">

									Date To

								</label>

								<input type="date"
									   id="date-to"
									   class="form-control"
									   required />

							</div>


							<div class="col-xl-6
								col-md-4">

								<div class="d-flex
									flex-wrap
									gap-2">

									<button type="submit"
											id="generate-report-button"
											class="btn btn-primary">

										<i class="ri-search-line
											align-middle
											me-1">
										</i>

										Generate Report

									</button>


									<button type="button"
											id="export-excel-button"
											class="btn btn-success"
											disabled>

										<i class="ri-file-excel-2-line
											align-middle
											me-1">
										</i>

										Excel

									</button>


									<button type="button"
											id="export-pdf-button"
											class="btn btn-danger"
											disabled>

										<i class="ri-file-pdf-2-line
											align-middle
											me-1">
										</i>

										PDF

									</button>

								</div>

							</div>


						</div>

					</form>


				</div>

			</div>


			<div class="card">

				<div class="card-header">

					<div class="d-flex
						align-items-center
						justify-content-between
						gap-2">

						<h5 class="card-title mb-0">
							Attendance Records
						</h5>


						<span id="report-record-count"
							  class="badge
							bg-primary-subtle
							text-primary">

							0

						</span>

					</div>

				</div>


				<div class="card-body p-0">

					<div class="table-responsive">

						<table class="table
							table-hover
							align-middle
							mb-0">

							<thead class="table-light">

								<tr>

									<th class="ps-3">
										Date
									</th>

									<th>
										Event
									</th>

									<th>
										Member
									</th>

									<th>
										Time In
									</th>

									<th class="pe-3">
										Time Out
									</th>

								</tr>

							</thead>


							<tbody id="report-table-body">

								<tr>

									<td colspan="5"
										class="text-center
										text-muted
										py-5">

										Select a date range
										and generate the report.

									</td>

								</tr>

							</tbody>

						</table>

					</div>

				</div>

			</div>


		</div>

	</div>

</div>


@section scripts {

	<script src="~/js/pages/reports/member-attendance.js"
			asp-append-version="true">
	</script>

}