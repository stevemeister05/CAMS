@{
	ViewBag.Title = "Admin Dashboard";
	ViewBag.PageTitle = "Dashboard";
	ViewBag.pTitle = "ADMIN DASHBOARD";

	Layout = "/Views/Shared/_Layout.cshtml";
}

<div id="admin-dashboard-page">


	<!-- =====================================================
		 PAGE TITLE
	===================================================== -->

	<div class="row">

		<div class="col-12">

			<div class="page-title-box
				d-sm-flex
				align-items-center
				justify-content-between">

				<div>

					<div id="dashboard-date"
						 class="text-muted">
					</div>

				</div>


				<button type="button"
						id="dashboard-refresh-button"
						class="btn btn-soft-primary">

					<i class="ri-refresh-line
						align-middle me-1">
					</i>

					Refresh

				</button>

			</div>

		</div>

	</div>


	<!-- =====================================================
		 SUMMARY CARDS
	===================================================== -->

	<div class="row mb-4">


		<div class="col-xl-3 col-md-6 d-flex">

			<a asp-area="Admin"
			   asp-controller="Member"
			   asp-action="Index"
			   class="text-reset w-100 h-100">

				<div class="card card-animate w-100 h-100">

					<div class="card-body">

						<div class="d-flex
							align-items-center">

							<div class="flex-grow-1">

								<p class="text-muted
									text-uppercase
									fw-medium mb-0">

									Active Members

								</p>

							</div>


							<div class="avatar-sm">

								<div class="avatar-title
									bg-primary-subtle
									text-primary
									rounded-circle fs-3">

									<i class="ri-group-line">
									</i>

								</div>

							</div>

						</div>


						<h3 id="active-member-count"
							class="mt-3 mb-0">

							—

						</h3>

					</div>

				</div>

			</a>

		</div>


		<div class="col-xl-3 col-md-6 d-flex">

			<div class="card card-animate w-100 h-100">

				<div class="card-body">

					<div class="d-flex
						align-items-center">

						<div class="flex-grow-1">

							<p class="text-muted
								text-uppercase
								fw-medium mb-0">

								Today's Attendance

							</p>

						</div>


						<div class="avatar-sm">

							<div class="avatar-title
								bg-success-subtle
								text-success
								rounded-circle fs-3">

								<i class="ri-user-follow-line">
								</i>

							</div>

						</div>

					</div>


					<h3 id="today-attendance-count"
						class="mt-3 mb-1">

						—

					</h3>


					<span id="today-attendance-rate"
						  class="text-muted fs-sm">

						—

					</span>

				</div>

			</div>

		</div>


		<div class="col-xl-3 col-md-6 d-flex">

			<a asp-area="Admin"
			   asp-controller="Registration"
			   asp-action="Index"
			   class="text-reset w-100 h-100">

				<div class="card card-animate w-100 h-100">

					<div class="card-body">

						<div class="d-flex
							align-items-center">

							<div class="flex-grow-1">

								<p class="text-muted
									text-uppercase
									fw-medium mb-0">

									Pending Registrations

								</p>

							</div>


							<div class="avatar-sm">

								<div class="avatar-title
									bg-warning-subtle
									text-warning
									rounded-circle fs-3">

									<i class="ri-user-add-line">
									</i>

								</div>

							</div>

						</div>


						<h3 id="pending-registration-count"
							class="mt-3 mb-0">

							—

						</h3>

					</div>

				</div>

			</a>

		</div>


		<div class="col-xl-3 col-md-6 d-flex">

			<a asp-area="Admin"
			   asp-controller="Event"
			   asp-action="Index"
			   class="text-reset w-100 h-100">

				<div class="card card-animate w-100 h-100">

					<div class="card-body">

						<div class="d-flex
							align-items-center">

							<div class="flex-grow-1">

								<p class="text-muted
									text-uppercase
									fw-medium mb-0">

									Today's Events

								</p>

							</div>


							<div class="avatar-sm">

								<div class="avatar-title
									bg-info-subtle
									text-info
									rounded-circle fs-3">

									<i class="ri-calendar-event-line">
									</i>

								</div>

							</div>

						</div>


						<h3 id="today-event-count"
							class="mt-3 mb-1">

							—

						</h3>


						<div id="today-event-summary"
							 class="text-muted fs-sm">

							—

						</div>

					</div>

				</div>

			</a>

		</div>

	</div>


	<!-- =====================================================
		 DASHBOARD CONTENT
	===================================================== -->

	<div class="row">


		<!-- =================================================
			 LEFT COLUMN
		================================================= -->

		<div class="col-xl-8">


			<!-- =============================================
				 TODAY'S EVENTS
			============================================= -->

			<div class="card mb-4">

				<div class="card-header">

					<h5 class="card-title mb-0">
						Today's Events
					</h5>

				</div>


				<div class="card-body p-0">

					<div class="table-responsive">

						<table class="table
							table-hover
							align-middle
							mb-0">

							<thead class="table-light">

								<tr>

									<th class="ps-3">
										Event
									</th>

									<th>
										Schedule
									</th>

									<th>
										Status
									</th>

									<th>
										Attendance Status
									</th>

									<th>
										Attendance
									</th>

									<th class="text-end pe-3">
										Action
									</th>

								</tr>

							</thead>


							<tbody id="today-events-body">
							</tbody>

						</table>

					</div>

				</div>

			</div>


			<!-- =============================================
				 RECENT ATTENDANCE
			============================================= -->

			<div class="card">

				<div class="card-header">

					<h5 class="card-title mb-0">
						Recent Attendance
					</h5>

				</div>


				<div class="card-body p-0">

					<div class="table-responsive">

						<table class="table
							table-hover
							align-middle
							mb-0">

							<thead class="table-light">

								<tr>

									<th class="ps-3">
										Member
									</th>

									<th>
										Event
									</th>

									<th>
										Time In
									</th>

									<th>
										Time Out
									</th>

								</tr>

							</thead>


							<tbody id="recent-attendance-body">
							</tbody>

						</table>

					</div>

				</div>

			</div>

		</div>


		<!-- =================================================
			 RIGHT COLUMN
		================================================= -->

		<div class="col-xl-4">


			<!-- =============================================
				 UPCOMING EVENTS
			============================================= -->

			<div class="card mb-4">

				<div class="card-header
					d-flex
					align-items-center
					justify-content-between">

					<h5 class="card-title mb-0">
						Upcoming Events
					</h5>


					<a asp-area="Admin"
					   asp-controller="Event"
					   asp-action="Index"
					   class="btn btn-sm btn-soft-primary">

						View All

					</a>

				</div>


				<div id="upcoming-events"
					 class="card-body">

					<div class="text-center
						text-muted py-4">

						Loading events...

					</div>

				</div>

			</div>


			<!-- =============================================
				 ATTENDANCE TREND
			============================================= -->

			<div class="card">

				<div class="card-header">

					<h5 class="card-title mb-0">
						Attendance — Last 7 Days
					</h5>

				</div>


				<div class="card-body">

					<div id="attendance-trend-chart"
						 style="min-height: 310px;">
					</div>

				</div>

			</div>

		</div>

	</div>

</div>


@section scripts {

	<script src="~/assets/libs/apexcharts/apexcharts.min.js"
			asp-append-version="true">
	</script>

	<script src="~/js/pages/admin/dashboard.js"
			asp-append-version="true">
	</script>

}