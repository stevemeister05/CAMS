@{
	ViewBag.Title = "Members";

	Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- =====================================================
	 PAGE TITLE
===================================================== -->

<div class="row">

	<div class="col-12">

		<div class="page-title-box
			d-sm-flex
			align-items-center
			justify-content-between">

			<h4 class="mb-sm-0">
				Members
			</h4>

		</div>

	</div>

</div>


<div id="member-management-page">


	<!-- =====================================================
		 FILTERS
	===================================================== -->

	<div class="card">

		<div class="card-body">

			<div class="row g-3 align-items-end">


				<!-- Search -->

				<div class="col-xl-4 col-md-6">

					<label for="member-search"
						   class="form-label">

						Search

					</label>


					<div class="position-relative">

						<input type="text"
							   id="member-search"
							   class="form-control"
							   placeholder="Name or mobile number..."
							   autocomplete="off">


						<i class="ri-search-line
							position-absolute
							top-50
							end-0
							translate-middle-y
							me-3
							text-muted">
						</i>

					</div>

				</div>


				<!-- Status -->

				<div class="col-xl-2 col-md-3">

					<label for="member-status-filter"
						   class="form-label">

						Status

					</label>


					<select id="member-status-filter"
							class="form-select">

						<option value="">
							All Statuses
						</option>

						<option value="true">
							Active
						</option>

						<option value="false">
							Inactive
						</option>

					</select>

				</div>


				<!-- Gender -->

				<div class="col-xl-2 col-md-3">

					<label for="member-gender-filter"
						   class="form-label">

						Gender

					</label>


					<select id="member-gender-filter"
							class="form-select">

						<option value="">
							All Genders
						</option>

						<option value="Male">
							Male
						</option>

						<option value="Female">
							Female
						</option>

					</select>

				</div>


				<!-- Page Size -->

				<div class="col-xl-2 col-md-3">

					<label for="member-page-size"
						   class="form-label">

						Rows

					</label>


					<select id="member-page-size"
							class="form-select">

						<option value="10">
							10
						</option>

						<option value="20"
								selected>
							20
						</option>

						<option value="50">
							50
						</option>

						<option value="100">
							100
						</option>

					</select>

				</div>


				<!-- Search -->

				<div class="col-xl-2 col-md-3">

					<div class="d-flex gap-2">

						<button type="button"
								id="member-search-button"
								class="btn btn-primary flex-grow-1">

							<i class="ri-search-line
								align-middle me-1">
							</i>

							Search

						</button>


						<button type="button"
								id="member-reset-button"
								class="btn btn-soft-secondary"
								title="Reset filters">

							<i class="ri-refresh-line
								align-middle">
							</i>

						</button>

					</div>

				</div>

			</div>

		</div>

	</div>


	<!-- =====================================================
		 MEMBERS
	===================================================== -->

	<div class="card">

		<div class="card-header">

			<div class="d-flex
				align-items-center
				justify-content-between">

				<div>

					<h5 class="card-title mb-1">
						Member List
					</h5>


					<p id="member-table-summary"
					   class="text-muted fs-sm mb-0">

						Loading members...

					</p>

				</div>


				<span id="member-total-count"
					  class="badge
					bg-primary-subtle
					text-primary fs-sm">

					0

				</span>

			</div>

		</div>


		<div class="card-body p-0">

			<div class="table-responsive">

				<table class="table
					table-hover
					align-middle
					mb-0">

					<thead class="table-light">

						<tr>

							<th class="ps-3">
								Member
							</th>

							<th>
								Mobile Number
							</th>

							<th>
								Birth Date
							</th>

							<th>
								Gender
							</th>

							<th>
								Status
							</th>

							<th>
								Registered
							</th>

							<th class="text-end pe-3">
								Actions
							</th>

						</tr>

					</thead>


					<tbody id="member-table-body">
					</tbody>

				</table>

			</div>

		</div>


		<div class="card-footer">

			<div class="d-flex
				flex-column
				flex-md-row
				align-items-md-center
				justify-content-between
				gap-3">


				<div id="member-pagination-info"
					 class="text-muted fs-sm">
				</div>


				<nav aria-label="Member pagination">

					<ul id="member-pagination"
						class="pagination
						pagination-sm
						mb-0">
					</ul>

				</nav>

			</div>

		</div>

	</div>


	<!-- =====================================================
		 EDIT MODAL
	===================================================== -->

	<div class="modal fade"
		 id="member-modal"
		 tabindex="-1"
		 aria-hidden="true">

		<div class="modal-dialog
			modal-lg
			modal-dialog-centered">

			<div class="modal-content">


				<form id="member-form"
					  novalidate>


					<div class="modal-header">

						<div>

							<h5 class="modal-title mb-1">
								Edit Member
							</h5>

							<div id="member-modal-name"
								 class="text-muted fs-sm">
							</div>

						</div>


						<button type="button"
								class="btn-close"
								data-bs-dismiss="modal"
								aria-label="Close">
						</button>

					</div>


					<div class="modal-body">


						<div id="member-form-error"
							 class="alert alert-danger d-none">
						</div>


						<div class="row g-3">


							<!-- First Name -->

							<div class="col-md-5">

								<label for="member-first-name"
									   class="form-label">

									First Name

									<span class="text-danger">
										*
									</span>

								</label>


								<input type="text"
									   id="member-first-name"
									   class="form-control"
									   required
									   maxlength="100">


								<div class="invalid-feedback">
									First name is required.
								</div>

							</div>


							<!-- Middle Name -->

							<div class="col-md-3">

								<label for="member-middle-name"
									   class="form-label">

									Middle Name

								</label>


								<input type="text"
									   id="member-middle-name"
									   class="form-control"
									   maxlength="100">

							</div>


							<!-- Last Name -->

							<div class="col-md-4">

								<label for="member-last-name"
									   class="form-label">

									Last Name

									<span class="text-danger">
										*
									</span>

								</label>


								<input type="text"
									   id="member-last-name"
									   class="form-control"
									   required
									   maxlength="100">


								<div class="invalid-feedback">
									Last name is required.
								</div>

							</div>


							<!-- Mobile Number -->

							<div class="col-md-6">

								<label for="member-mobile-number"
									   class="form-label">

									Mobile Number

									<span class="text-danger">
										*
									</span>

								</label>


								<input type="text"
									   id="member-mobile-number"
									   class="form-control"
									   inputmode="numeric"
									   maxlength="11"
									   required>


								<div class="invalid-feedback">
									Mobile number is required.
								</div>

							</div>


							<!-- Birth Date -->

							<div class="col-md-3">

								<label for="member-birth-date"
									   class="form-label">

									Birth Date

								</label>


								<input type="date"
									   id="member-birth-date"
									   class="form-control">

							</div>


							<!-- Gender -->

							<div class="col-md-3">

								<label for="member-gender"
									   class="form-label">

									Gender

								</label>


								<select id="member-gender"
										class="form-select">

									<option value="">
										Select...
									</option>

									<option value="Male">
										Male
									</option>

									<option value="Female">
										Female
									</option>

								</select>

							</div>


							<!-- Address -->

							<div class="col-12">

								<label for="member-address"
									   class="form-label">

									Address

								</label>


								<textarea id="member-address"
										  class="form-control"
										  rows="3">
								</textarea>

							</div>

						</div>

					</div>


					<div class="modal-footer">

						<button type="button"
								class="btn btn-light"
								data-bs-dismiss="modal">

							Cancel

						</button>


						<button type="submit"
								id="member-save-button"
								class="btn btn-primary">

							<i class="ri-save-line
								align-middle me-1">
							</i>

							Save Changes

						</button>

					</div>

				</form>

			</div>

		</div>

	</div>

</div>


@section scripts {

	<script src="~/js/pages/admin/members.js"
			asp-append-version="true">
	</script>

}