@{
	ViewBag.Title = "Member Registration";
	ViewBag.PageTitle = "Pages";
	ViewBag.pTitle = "MEMBER REGISTRATION";
	Layout = "/Views/Shared/_BlankLayout2.cshtml";
}
<div class="text-center mb-4">

	<div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3"
		 style="width: 64px; height: 64px;">

		<i class="ri-community-line fs-2"></i>

	</div>

	<h2 class="fw-bold mb-1">
		Sta. Barbara Chapel
	</h2>

	<p class="text-muted mb-0">
		Member Registration
	</p>

</div>
<div class="row justify-content-center">
	<div class="col-xl-8 col-xxl-7">

		<div class="card">

			<div class="card-header">
				<h5 class="card-title mb-1">
					Member Registration
				</h5>

				<p class="text-muted mb-0">
					Please provide your information below.
				</p>
			</div>

			<div class="card-body">

				<div class="mb-4">
					<small class="text-muted">
						Fields marked with
						<span class="text-danger">*</span>
						are required.
					</small>
				</div>

				<hr class="my-4">

				<form id="registration-form">

					<!-- =====================================================
						 PERSONAL DETAILS
					===================================================== -->

					<div class="mb-4">
						<h6 class="fw-semibold">
							Personal Details
						</h6>

						<p class="text-muted mb-0">
							Enter your personal information.
						</p>
					</div>

					<div class="row">

						<!-- First Name -->
						<div class="col-lg-4">
							<div class="mb-3">

								<label
									for="first-name"
									class="form-label">

									First Name
									<span class="text-danger">*</span>

								</label>

								<input
									type="text"
									class="form-control"
									id="first-name"
									name="FirstName"
									maxlength="100"
									placeholder="Enter your first name"
									autocomplete="given-name"
									required>

							</div>
						</div>


						<!-- Middle Name -->
						<div class="col-lg-4">
							<div class="mb-3">

								<label
									for="middle-name"
									class="form-label">

									Middle Name

								</label>

								<input
									type="text"
									class="form-control"
									id="middle-name"
									name="MiddleName"
									maxlength="100"
									placeholder="Enter your middle name"
									autocomplete="additional-name">

							</div>
						</div>


						<!-- Last Name -->
						<div class="col-lg-4">
							<div class="mb-3">

								<label
									for="last-name"
									class="form-label">

									Last Name
									<span class="text-danger">*</span>

								</label>

								<input
									type="text"
									class="form-control"
									id="last-name"
									name="LastName"
									maxlength="100"
									placeholder="Enter your last name"
									autocomplete="family-name"
									required>

							</div>
						</div>


						<!-- Mobile Number -->
						<div class="col-lg-6">
							<div class="mb-3">

								<label
									for="mobile-number"
									class="form-label">

									Mobile Number
									<span class="text-danger">*</span>

								</label>

								<input
									type="tel"
									class="form-control"
									id="mobile-number"
									name="MobileNumber"
									placeholder="09xxxxxxxxx"
									inputmode="numeric"
									autocomplete="tel"
									minlength="11"
									maxlength="11"
									pattern="09[0-9]{9}"
									required>

								<div class="form-text">
									Enter an 11-digit Philippine mobile number
									in the format
									<strong>09xxxxxxxxx</strong>.
								</div>

							</div>
						</div>


						<!-- Birth Date -->
						<div class="col-lg-6">
							<div class="mb-3">

								<label
									for="birth-date"
									class="form-label">

									Birth Date

								</label>

								<input
									type="date"
									class="form-control"
									id="birth-date"
									name="BirthDate"
									autocomplete="bday">

							</div>
						</div>


						<!-- Gender -->
						<div class="col-lg-6">
							<div class="mb-3">

								<label
									for="gender"
									class="form-label">

									Sex

								</label>

								<select
									class="form-select"
									id="gender"
									name="Gender">

									<option value="">
										Select gender
									</option>

									<option value="Male">
										Male
									</option>

									<option value="Female">
										Female
									</option>

								</select>

							</div>
						</div>

					</div>


					<!-- =====================================================
						 ACCOUNT DETAILS
					===================================================== -->

					<hr class="my-4">

					<div class="mb-4">
						<h6 class="fw-semibold">
							Account Details
						</h6>

						<p class="text-muted mb-0">
							Your mobile number will be used as your username.
						</p>
					</div>

					<div class="row">

						<!-- Username -->
						<div class="col-lg-6">
							<div class="mb-3">

								<label
									for="username"
									class="form-label">

									Username

								</label>

								<input
									type="text"
									class="form-control"
									id="username"
									placeholder="09xxxxxxxxx"
									readonly
									disabled
									>

								<div class="form-text">
									Your username is the same as your mobile number.
								</div>

							</div>
						</div>


						<!-- Password -->
						<div class="col-lg-6">
							<div class="mb-3">

								<label
									for="password"
									class="form-label">

									Password
									<span class="text-danger">*</span>

								</label>

								<input
									type="password"
									class="form-control"
									id="password"
									name="Password"
									placeholder="Enter your password"
									autocomplete="new-password"
									required>

								<div class="form-text">
									Choose a secure password for your account.
								</div>

							</div>
						</div>


						<!-- Submit -->
						<div class="col-lg-12">
							<div class="hstack gap-2 justify-content-end mt-3">

								<button
									type="submit"
									id="register-button"
									class="btn btn-primary px-4">

									<i class="ri-user-add-line me-1"></i>
									Register

								</button>

							</div>
						</div>

					</div>

				</form>

			</div>
		</div>

	</div>
</div>

@section Scripts {
	<script src="~/js/pages/registration.js" asp-append-version="true"></script>
}