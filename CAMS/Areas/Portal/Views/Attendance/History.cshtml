@{
	ViewData["Title"] =
		"Attendance History";

	Layout =
		"/Areas/Portal/Views/Shared/_Layout.cshtml";
}


<div id="portal-attendance-history-page">

	<div class="row justify-content-center">

		<div class="col-xl-10">


			<div class="d-flex
				align-items-center
				justify-content-between
				flex-wrap
				gap-2
				mb-4">

				<div>

					<h4 class="mb-1">
						Attendance History
					</h4>

					<p class="text-muted mb-0">
						View your recorded attendance
						at chapel events.
					</p>

				</div>


				<div class="d-flex gap-2">

					<button type="button"
							id="refresh-attendance-history-button"
							class="btn btn-light">

						<i class="ri-refresh-line
							align-middle me-1">
						</i>

						Refresh

					</button>


					<a asp-area="Portal"
					   asp-controller="Home"
					   asp-action="Index"
					   class="btn btn-light">

						<i class="ri-arrow-left-line
							align-middle me-1">
						</i>

						Back to Portal

					</a>

				</div>

			</div>


			<div id="attendance-history-alert">
			</div>


			<div class="card">

				<div class="card-header">

					<div class="d-flex
						align-items-center
						justify-content-between">

						<div>

							<h5 class="card-title mb-1">
								My Attendance
							</h5>

							<p class="text-muted mb-0">
								Your most recent attendance
								appears first.
							</p>

						</div>


						<span id="attendance-history-count"
							  class="badge
							bg-primary-subtle
							text-primary">

							0

						</span>

					</div>

				</div>


				<div class="card-body p-0">

					<div class="table-responsive">

						<table class="table
							table-hover
							align-middle
							mb-0">

							<thead class="table-light">

								<tr>

									<th class="ps-3">
										Event
									</th>

									<th>
										Date
									</th>

									<th>
										Time In
									</th>

									<th>
										Time Out
									</th>

									<th class="pe-3">
										Method
									</th>

								</tr>

							</thead>


							<tbody id="attendance-history-body">
							</tbody>

						</table>

					</div>

				</div>

			</div>

		</div>

	</div>

</div>


@section scripts {

	<script src="~/js/pages/portal/attendance-history.js"
			asp-append-version="true">
	</script>

}