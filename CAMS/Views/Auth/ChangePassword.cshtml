@{
	ViewBag.Title =
		"Change Password";

	Layout =
		"~/Views/Shared/_BlankLayout2.cshtml";

	var displayName =
		ViewData["DisplayName"]?.ToString() ??
		"there";

	var message =
		ViewData["ChangePasswordMessage"]?.ToString();
}


<section class="auth-page-wrapper py-5 position-relative
				d-flex align-items-center justify-content-center min-vh-100">

	<div class="container">

		<div class="row justify-content-center">

			<div class="col-lg-6 col-xl-5">

				<!-- =====================================================
					 HEADER
				===================================================== -->

				<div class="text-center mb-4">

					<div class="avatar-lg mx-auto mb-3">

						<div class="avatar-title bg-primary-subtle
									text-primary rounded-circle fs-2">

							<i class="ri-lock-password-line"></i>

						</div>

					</div>


					<h4 class="mb-1">
						Sta. Barbara Chapel
					</h4>

					<p class="text-muted mb-0">
						Church Attendance Management System
					</p>

				</div>


				<!-- =====================================================
					 CHANGE PASSWORD CARD
				===================================================== -->

				<div class="card mb-0">

					<div class="card-body p-sm-5">


						<!-- =================================================
							 TITLE
						================================================= -->

						<div class="text-center mb-4">

							<h5 class="fs-3xl mb-2">
								Change Password
							</h5>

							<p class="text-muted mb-0">

								Hi
								<span class="fw-semibold text-body">
									@displayName
								</span>,

								please create a secure password
								for your account.

							</p>

						</div>


						<!-- =================================================
							 OPTIONAL CONTEXT MESSAGE
						================================================= -->

						@if (
							!string.IsNullOrWhiteSpace(
								message))
						{
							<div class="alert alert-info d-flex align-items-start"
								 role="alert">

								<i class="ri-information-line fs-lg me-2 mt-1"></i>

								<div>
									@message
								</div>

							</div>
						}


						<!-- =================================================
							 ERROR MESSAGE
						================================================= -->

						<div id="change-password-error"
							 class="alert alert-danger d-none"
							 role="alert">
						</div>


						<!-- =================================================
							 FORM
						================================================= -->

						<form id="change-password-form"
							  novalidate>


							<!-- =============================================
								 CURRENT PASSWORD
							============================================= -->

							<div class="mb-3">

								<label class="form-label"
									   for="current-password">

									Current Password

									<span class="text-danger">
										*
									</span>

								</label>


								<div class="position-relative auth-pass-inputgroup">

									<input type="password"
										   class="form-control pe-5"
										   id="current-password"
										   name="CurrentPassword"
										   placeholder="Enter your current password"
										   autocomplete="current-password"
										   required>


									<button type="button"
											class="btn btn-link position-absolute
												   end-0 top-0 text-decoration-none
												   text-muted password-addon"
											data-password-toggle="current-password"
											aria-label="Show current password">

										<i class="ri-eye-fill align-middle"></i>

									</button>

								</div>

								<div class="invalid-feedback">
									Please enter your current password.
								</div>

							</div>


							<!-- =============================================
								 NEW PASSWORD
							============================================= -->

							<div class="mb-3">

								<label class="form-label"
									   for="new-password">

									New Password

									<span class="text-danger">
										*
									</span>

								</label>


								<div class="position-relative auth-pass-inputgroup">

									<input type="password"
										   class="form-control pe-5"
										   id="new-password"
										   name="NewPassword"
										   placeholder="Enter your new password"
										   autocomplete="new-password"
										   minlength="8"
										   required>


									<button type="button"
											class="btn btn-link position-absolute
												   end-0 top-0 text-decoration-none
												   text-muted password-addon"
											data-password-toggle="new-password"
											aria-label="Show new password">

										<i class="ri-eye-fill align-middle"></i>

									</button>

								</div>

								<div class="invalid-feedback">
									Please enter a valid new password.
								</div>

							</div>


							<!-- =============================================
								 CONFIRM PASSWORD
							============================================= -->

							<div class="mb-3">

								<label class="form-label"
									   for="confirm-password">

									Confirm New Password

									<span class="text-danger">
										*
									</span>

								</label>


								<div class="position-relative auth-pass-inputgroup">

									<input type="password"
										   class="form-control pe-5"
										   id="confirm-password"
										   placeholder="Confirm your new password"
										   autocomplete="new-password"
										   minlength="8"
										   required>


									<button type="button"
											class="btn btn-link position-absolute
												   end-0 top-0 text-decoration-none
												   text-muted password-addon"
											data-password-toggle="confirm-password"
											aria-label="Show confirmed password">

										<i class="ri-eye-fill align-middle"></i>

									</button>

								</div>

								<div class="invalid-feedback"
									 id="confirm-password-error">

									Please confirm your new password.

								</div>

							</div>

							<!-- =============================================
								 SUBMIT
							============================================= -->

							<div class="mt-4">

								<button type="submit"
										id="change-password-button"
										class="btn btn-primary w-100">

									<span id="change-password-button-text">
										Change Password
									</span>

									<span id="change-password-spinner"
										  class="spinner-border spinner-border-sm
												 ms-2 d-none"
										  role="status"
										  aria-hidden="true">
									</span>

								</button>

							</div>

						</form>

					</div>

				</div>

			</div>

		</div>

	</div>

</section>


@section Scripts {

	<script src="~/js/pages/change-password.js"
			asp-append-version="true"></script>

}